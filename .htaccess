DirectoryIndex disabled

RewriteEngine On

# Redirigir todas las peticiones al proceso de Node.js.
# Este puerto debe coincidir con server.js cuando no existe process.env.PORT.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.*)$ http://127.0.0.1:3300/$1 [P,L,QSA]
